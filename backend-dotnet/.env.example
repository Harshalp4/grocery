# Copy to `.env` (gitignored) and fill in. Real environment variables override.
# See SOCIAL_SIGN_IN.md for how these are used.

# Resend — transactional email for the login OTP.
RESEND_API_KEY=
# Optional verified sender (else Resend's sandbox onboarding@resend.dev is used).
RESEND_FROM=
# Where new-order alert emails are sent (a real inbox). Falls back to Admin__Email.
# NOTE: with Resend's sandbox sender you can only email your own account address
# until you verify a domain.
ORDER_ALERT_EMAIL=

# Firebase — verifies Google/Apple sign-in ID tokens (your Firebase project id).
FIREBASE_PROJECT_ID=
# Firebase service account JSON (or a path to the .json) — lets the backend SEND
# push via FCM HTTP v1. Paste the whole downloaded JSON. SECRET — never commit.
FIREBASE_SERVICE_ACCOUNT=

# Cloudinary — durable image storage for product images + delivery-proof photos.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>. Unset = local disk.
CLOUDINARY_URL=

# Set to false in production so the OTP is not returned in the API response.
OTP_DEV_MODE=
